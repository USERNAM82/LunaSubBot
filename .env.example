# ضعها في Vercel: Project → Settings → Environment Variables  (لا ترفع ملف .env إلى git)

# رابط البوت (بدون / في الآخر). إن كان البوت على منفذ مخصص اكتبه: http://lunabot.hidenplay.net:24686
LUNA_BOT_URL=https://lunabot.hidenplay.net

# المفتاح السري — يجب أن يطابق تمامًا data/panel/api.key (أو LUNA_API_KEY) على البوت. 64 حرف hex.
# يولَّد بالأمر:  npm run gen-key
LUNA_API_KEY=

# (اختياري) أقصى عدد طلبات في الدقيقة لكل IP على سيرفر Vercel
# LUNA_RATE_PER_MIN=90
